# Ollama 本地服务
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3

# Hugging Face 数据集（可换成其他公开数据集 ID）
HF_DATASET_ID=ppak10/Additive-Manufacturing-Benchmark
# 留空则自动挑选文本类配置；也可填写确切的配置名
HF_DATASET_CONFIG=

# OpenAlex 检索设置
OPENALEX_PER_QUERY=30
OPENALEX_MAILTO=

# 本地向量库
CHROMA_PATH=./chroma_db
COLLECTION_NAME=am_knowledge

# 工艺标签配置文件（留空则使用 amrag/processes.json）
PROCESS_FILE=
